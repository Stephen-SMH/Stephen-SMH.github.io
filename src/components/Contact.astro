---
import type { Dict } from "@/content";
import Animal from "./Animal.astro";
import Section from "./Section.astro";
import SectionHead from "./SectionHead.astro";

const { contact } = Astro.props as { contact: Dict["contact"] };
const { chat, direct, card } = contact;
const mail = (subject: string) => `mailto:${direct.email}?subject=${encodeURIComponent(subject)}`;
const payload = JSON.stringify({
  to: direct.email,
  options: chat.options,
  restart: chat.restart,
  methods: {
    email: { label: direct.emailLabel, value: direct.email },
    linkedin: { label: direct.linkedinLabel, value: direct.linkedin, url: direct.linkedinUrl },
    github: { label: direct.githubLabel, value: direct.github, url: direct.githubUrl },
    phone: { label: direct.phoneLabel, value: direct.phoneMasked, hint: direct.reveal, aria: direct.revealAria },
  },
});
---
<Section id="contact" class="cs-theme">
  <SectionHead eyebrow={contact.eyebrow} title={contact.title} />

  <div class="ct-wrap rounded-[2rem] p-5 sm:p-10">
    <div class="grid items-center gap-10 lg:grid-cols-[1fr_0.9fr] lg:gap-16">
      <!-- left: statement, status chips, quick copy -->
      <div class="text-white">
        <p class="max-w-[16ch] font-display text-[clamp(2.2rem,5.2vw,4.2rem)] font-semibold leading-[1.02] tracking-tighter">{chat.lead}</p>
        <div class="mt-8 flex flex-wrap gap-2.5">
          <span class="ct-chip"><i class="relative flex h-2 w-2"><i class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-300 opacity-70"></i><i class="relative inline-flex h-2 w-2 rounded-full bg-emerald-300"></i></i>{card.availability}</span>
          <span class="ct-chip">{card.location}</span>
        </div>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <button type="button" data-copy={direct.email} data-copied={chat.copied} class="ct-chip ct-chip-btn">
            <span data-copy-label>{chat.copy}</span><span class="text-white/50">·</span><span class="font-mono text-[12px] text-white/70">{direct.email}</span>
          </button>
          <a href={`mailto:${direct.email}`} class="text-[13px] text-white/60 underline-offset-4 transition-colors hover:text-white hover:underline">{chat.skip}</a>
        </div>
      </div>

      <!-- right: the chat -->
      <div class="ct-phone mx-auto w-full max-w-[24rem] rounded-[2.2rem] p-2.5" data-chat={payload}>
        <div class="flex h-[34rem] flex-col rounded-[1.8rem] bg-[#12122b]/80 backdrop-blur">
          <div class="flex items-center gap-3 border-b border-white/10 px-4 py-3.5">
            <span class="grid h-10 w-10 shrink-0 place-items-center overflow-hidden rounded-full" style="background:linear-gradient(135deg,#f472b6,#6366f1)">
              <Animal kind="fox" class="mt-2 h-10 w-9" />
            </span>
            <div class="min-w-0">
              <p class="text-[15px] font-medium text-white">{chat.name}</p>
              <p class="flex items-center gap-1.5 truncate font-mono text-[11px] text-white/55"><i class="h-1.5 w-1.5 shrink-0 rounded-full bg-emerald-300"></i>{chat.online}</p>
            </div>
          </div>

          <div data-chat-log data-lenis-prevent class="flex-1 space-y-2.5 overflow-y-auto px-4 py-4 text-[14px]">
            <p class="ct-bot">{chat.hello}</p>
            <p class="ct-bot">{chat.ask}</p>
          </div>

          <div data-chat-opts class="flex flex-wrap gap-2 border-t border-white/10 px-4 py-3.5">
            {chat.options.map((o, i) => <a href={mail(o.subject)} data-chat-opt={i} class="ct-reply">{o.label}</a>)}
          </div>
        </div>
      </div>
    </div>
  </div>
</Section>
