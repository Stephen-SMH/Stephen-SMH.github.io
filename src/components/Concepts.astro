---
import type { Dict } from "@/content";
import Bezel from "./Bezel.astro";
import Reveal from "./Reveal.astro";
import Section from "./Section.astro";
import SectionHead from "./SectionHead.astro";
import Badge from "./Badge.astro";

const { concepts } = Astro.props as { concepts: Dict["concepts"] };
/* Shared SVG look: box = tinted plate with a rule outline; txt = mono label; ln = connector. */
const box = "fill-accent-soft stroke-accent";
const plain = "fill-core stroke-rule";
const txt = "fill-ink font-mono";
const dim = "fill-ink-faint font-mono";
const ln = "stroke-accent fill-none";
---
<Section id="concepts">
  <SectionHead eyebrow={concepts.eyebrow} title={concepts.title} />
  <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
    {concepts.items.map((c, i) => (
      <Reveal variant="card">
        <Bezel lift class="h-full" core="flex h-full flex-col p-6">
          <div class="flex items-center justify-between">
            <Badge>{c.tag}</Badge>
            <span class="font-mono text-[12px] text-ink-faint">{String(i + 1).padStart(2, "0")}</span>
          </div>
          <svg viewBox="0 0 320 170" role="img" aria-label={`${c.title} diagram`} class="mt-5 h-auto w-full" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
            <defs>
              <marker id={`ah${i}`} viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6" markerHeight="6" orient="auto">
                <path d="M0 0L8 4L0 8z" class="fill-accent stroke-none" />
              </marker>
            </defs>

            {i === 0 && (<>
              <rect x="8" y="30" width="112" height="110" rx="8" class={plain} />
              <text x="64" y="48" text-anchor="middle" class={txt} font-size="10" font-weight="600">orders</text>
              {["id", "customer", "email", "item", "price"].map((f, k) => <text x="20" y={68 + k * 14} class={dim} font-size="9">{f}</text>)}
              <path d="M126 85H160" class={ln} marker-end={`url(#ah${i})`} />
              <rect x="168" y="12" width="70" height="46" rx="6" class={box} />
              <text x="203" y="28" text-anchor="middle" class={txt} font-size="9" font-weight="600">customers</text>
              <text x="203" y="44" text-anchor="middle" class={dim} font-size="8">id · email</text>
              <rect x="244" y="62" width="68" height="46" rx="6" class={box} />
              <text x="278" y="78" text-anchor="middle" class={txt} font-size="9" font-weight="600">items</text>
              <text x="278" y="94" text-anchor="middle" class={dim} font-size="8">id · price</text>
              <rect x="168" y="112" width="70" height="46" rx="6" class={box} />
              <text x="203" y="128" text-anchor="middle" class={txt} font-size="9" font-weight="600">orders</text>
              <text x="203" y="144" text-anchor="middle" class={dim} font-size="8">cust · item</text>
              <path d="M203 58V112M238 135H258V108M238 35H278V62" class={ln} stroke-dasharray="3 3" />
            </>)}

            {i === 1 && (<>
              {["Commit", "Build", "Test", "Deploy", "Monitor"].map((s, k) => (
                <>
                  <rect x={6 + k * 62} y="62" width="54" height="40" rx="8" class={k === 4 ? box : plain} />
                  <text x={33 + k * 62} y="86" text-anchor="middle" class={txt} font-size="9">{s}</text>
                  {k < 4 && <path d={`M${60 + k * 62} 82H${68 + k * 62}`} class={ln} marker-end={`url(#ah${i})`} />}
                </>
              ))}
              <path d="M279 102V138H33V106" class={ln} stroke-dasharray="3 3" marker-end={`url(#ah${i})`} />
              <text x="156" y="154" text-anchor="middle" class={dim} font-size="9">feedback to the next commit</text>
              <text x="160" y="40" text-anchor="middle" class={dim} font-size="9">Docker · GitHub Actions · Grafana</text>
            </>)}

            {i === 2 && (<>
              <rect x="8" y="55" width="76" height="60" rx="8" class={box} />
              <text x="46" y="82" text-anchor="middle" class={txt} font-size="10" font-weight="600">React</text>
              <text x="46" y="98" text-anchor="middle" class={dim} font-size="8">browser UI</text>
              <rect x="122" y="55" width="76" height="60" rx="8" class={box} />
              <text x="160" y="82" text-anchor="middle" class={txt} font-size="10" font-weight="600">API</text>
              <text x="160" y="98" text-anchor="middle" class={dim} font-size="8">FastAPI</text>
              <ellipse cx="274" cy="38" rx="32" ry="10" class={plain} /><path d="M242 38V62c0 6 14 10 32 10s32-4 32-10V38" class={plain} />
              <text x="274" y="60" text-anchor="middle" class={txt} font-size="9">PostgreSQL</text>
              <rect x="244" y="104" width="60" height="34" rx="6" class={plain} />
              <text x="274" y="125" text-anchor="middle" class={txt} font-size="9">Redis</text>
              <path d="M84 85H122M198 75L242 55M198 95L244 118" class={ln} marker-end={`url(#ah${i})`} />
              <text x="103" y="78" text-anchor="middle" class={dim} font-size="8">HTTP</text>
            </>)}

            {i === 3 && (<>
              <rect x="70" y="8" width="180" height="154" rx="14" class={plain} />
              <rect x="88" y="30" width="144" height="116" rx="12" class={plain} />
              <rect x="106" y="52" width="108" height="78" rx="10" class={box} />
              <text x="160" y="22" text-anchor="middle" class={dim} font-size="9">Edge · rate limit</text>
              <text x="160" y="44" text-anchor="middle" class={dim} font-size="9">Auth · JWT · RBAC</text>
              <text x="160" y="76" text-anchor="middle" class={txt} font-size="9">Validation</text>
              <text x="160" y="90" text-anchor="middle" class={dim} font-size="8">schemas · sanitising</text>
              <text x="160" y="112" text-anchor="middle" class={txt} font-size="9" font-weight="600">Data</text>
              <text x="160" y="124" text-anchor="middle" class={dim} font-size="8">encrypted</text>
            </>)}

            {i === 4 && (<>
              <rect x="8" y="68" width="48" height="34" rx="6" class={plain} />
              <text x="32" y="89" text-anchor="middle" class={txt} font-size="9">Client</text>
              <rect x="82" y="68" width="48" height="34" rx="6" class={box} />
              <text x="106" y="89" text-anchor="middle" class={txt} font-size="9">LB</text>
              {[16, 68, 120].map((y) => (
                <>
                  <rect x="160" y={y} width="52" height="30" rx="6" class={plain} />
                  <text x="186" y={y + 19} text-anchor="middle" class={txt} font-size="9">App</text>
                  <path d={`M130 85L160 ${y + 15}`} class={ln} />
                  <path d={`M212 ${y + 15}L240 85`} class={ln} />
                </>
              ))}
              <rect x="240" y="40" width="70" height="30" rx="6" class={box} />
              <text x="275" y="59" text-anchor="middle" class={txt} font-size="9">Cache</text>
              <rect x="240" y="100" width="70" height="30" rx="6" class={plain} />
              <text x="275" y="119" text-anchor="middle" class={txt} font-size="9">DB + replica</text>
              <path d="M56 85H82" class={ln} marker-end={`url(#ah${i})`} />
            </>)}

            {i === 5 && (<>
              <circle cx="30" cy="62" r="9" class={plain} />
              <path d="M30 71V102M12 82H48M30 102L16 126M30 102L44 126" class="stroke-ink-faint fill-none" />
              <text x="30" y="148" text-anchor="middle" class={dim} font-size="9">Marketer</text>
              <rect x="86" y="8" width="226" height="154" rx="10" class={plain} stroke-dasharray="4 3" />
              <text x="199" y="24" text-anchor="middle" class={dim} font-size="9">Social platform</text>
              {["Connect account", "Compose post", "Schedule post", "View activity"].map((u, k) => (
                <>
                  <ellipse cx="199" cy={46 + k * 32} rx="68" ry="15" class={box} />
                  <text x="199" y={49 + k * 32} text-anchor="middle" class={txt} font-size="9">{u}</text>
                  <path d={`M46 90L${131} ${46 + k * 32}`} class="stroke-rule fill-none" />
                </>
              ))}
            </>)}
          </svg>
          <h3 class="mt-5 font-display text-lg font-semibold tracking-tight text-ink">{c.title}</h3>
          <p class="mt-1.5 text-[14px] leading-relaxed text-ink-soft">{c.desc}</p>
        </Bezel>
      </Reveal>
    ))}
  </div>
</Section>
