---
import type { Dict } from "@/content";

const { dict } = Astro.props as { dict: Dict };
const { footer, brand, nav, contact } = dict;
const GAMES_URL = "/game-portfolio/";
const link = "transition-colors duration-500 hover:text-accent";
---
<footer class="overflow-hidden pb-12 pt-8">
  <div class="mx-auto w-full max-w-[1440px] px-5 sm:px-8">
    <div class="draw-rule" data-rule></div>
    <div class="flex flex-col gap-8 pt-10 md:flex-row md:items-end md:justify-between">
      <nav aria-label="Footer" class="flex flex-wrap gap-x-6 gap-y-2 text-[14px] text-ink-soft">
        <a href="#about" class={link}>{nav.about}</a>
        <a href="#projects" class={link}>{nav.projects}</a>
        <a href="#blog" class={link}>{nav.notes}</a>
        <a href={contact.direct.githubUrl} target="_blank" rel="noreferrer noopener" class={link}>{footer.github}</a>
        <a href={GAMES_URL} target="_blank" rel="noreferrer noopener" class={link}>{footer.games}</a>
        <a href={contact.direct.linkedinUrl} target="_blank" rel="noreferrer noopener" class={link}>{footer.linkedin}</a>
        <a href={`mailto:${contact.direct.email}`} class={link}>{footer.email}</a>
      </nav>
      <p class="text-[13px] text-ink-faint md:max-w-md md:text-right">
        {footer.built} © {new Date().getFullYear()} {brand.name}. {footer.rights}
      </p>
    </div>

    <!-- Oversized wordmark; rises into place and drifts with scroll. -->
    <a
      href="#main"
      data-footer-mark
      aria-label={brand.name}
      class="mt-14 block select-none font-display text-[clamp(3.5rem,13.5vw,12rem)] font-semibold leading-[0.9] tracking-tighter text-ink/90"
    ><span data-split="footer">{brand.name}</span></a>
  </div>
</footer>
