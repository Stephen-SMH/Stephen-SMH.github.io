---
import { ArrowUp, EnvelopeSimple, GameController, GithubLogo, LinkedinLogo } from "@phosphor-icons/react/dist/ssr";
import type { Dict } from "@/content";

const { dict } = Astro.props as { dict: Dict };
const { footer, brand, nav, contact } = dict;
const GAMES_URL = "/game-portfolio/";
const pages = [
  ["#about", nav.about],
  ["#skills", nav.skills],
  ["#experience", nav.experience],
  ["#projects", nav.projects],
  ["#contact", nav.contact],
];
const social = [
  [contact.direct.githubUrl, footer.github, GithubLogo, true],
  [contact.direct.linkedinUrl, footer.linkedin, LinkedinLogo, true],
  [`mailto:${contact.direct.email}`, footer.email, EnvelopeSimple, false],
  [GAMES_URL, footer.games, GameController, true],
] as const;
---
<footer class="pb-12 pt-8" aria-label="Site footer">
  <div class="mx-auto w-full max-w-[1440px] px-5 sm:px-8">
    <!-- hairline that fades out at both ends; the only decoration -->
    <div aria-hidden="true" class="h-px w-full" style="background:linear-gradient(90deg,transparent,hsl(318 80% 66% / .55),hsl(262 80% 62% / .55),transparent)"></div>

    <div class="grid gap-10 pt-10 sm:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_auto] lg:gap-16">
      <div class="max-w-sm">
        <p class="font-display text-xl font-semibold tracking-tight text-ink">{brand.name}</p>
        <p class="mt-2 text-[15px] leading-relaxed text-ink-soft">{dict.hero.role} · {dict.hero.focus.split(" · ")[0]}</p>
        <p class="mt-4 inline-flex items-center gap-2 text-[14px] text-ink-soft">
          <i class="relative flex h-2 w-2" aria-hidden="true"><i class="absolute inline-flex h-full w-full animate-ping rounded-full bg-success opacity-70"></i><i class="relative inline-flex h-2 w-2 rounded-full bg-success"></i></i>
          Bangkok · <span data-bkk-time class="tabular-nums">--:--</span> UTC+7
        </p>
      </div>

      <nav aria-label="Footer pages">
        <h2 class="font-mono text-[12px] uppercase tracking-[0.14em] text-ink-faint">Pages</h2>
        <ul class="mt-3 -ml-2">
          {pages.map(([href, label]) => <li><a href={href} class="ft-link">{label}</a></li>)}
        </ul>
      </nav>

      <nav aria-label="Footer links">
        <h2 class="font-mono text-[12px] uppercase tracking-[0.14em] text-ink-faint">Elsewhere</h2>
        <ul class="mt-3 -ml-2">
          {social.map(([href, label, Icon, ext]) => (
            <li>
              <a href={href} target={ext ? "_blank" : undefined} rel={ext ? "noreferrer noopener" : undefined} class="ft-link">
                <Icon size={18} weight="light" aria-hidden="true" />{label}
                {ext && <span class="sr-only"> (opens in a new tab)</span>}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="sm:col-span-2 lg:col-span-1 lg:justify-self-end">
        <a href="#main" class="ft-top">
          Back to top <ArrowUp size={16} weight="light" aria-hidden="true" />
        </a>
      </div>
    </div>

    <div class="mt-10 flex flex-col gap-1.5 border-t border-rule pt-6 text-[13px] leading-relaxed text-ink-faint sm:flex-row sm:items-center sm:justify-between">
      <p>© {new Date().getFullYear()} {brand.name}. {footer.rights}</p>
      <p>{footer.built}</p>
    </div>
  </div>
</footer>
<script>
  const tick = () => {
    const t = new Intl.DateTimeFormat("en-GB", { hour: "2-digit", minute: "2-digit", timeZone: "Asia/Bangkok" }).format(new Date());
    document.querySelectorAll<HTMLElement>("[data-bkk-time]").forEach((n) => (n.textContent = t));
  };
  tick();
  setInterval(tick, 30000);
</script>
