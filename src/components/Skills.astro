<style is:inline set:html={css + `.a{animation-duration:${D}s;animation-timing-function:linear;animation-iteration-count:infinite}`}></style>
<script>
  const root = document.querySelector<HTMLElement>("[data-skills]");
  if (root) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>("[data-skill-tab]")];
    const panels = [...root.querySelectorAll<HTMLElement>("[data-skill-panel]")];
    const scenes = [...root.querySelectorAll<HTMLElement>("[data-scene]")];
    const title = root.querySelector<HTMLElement>("[data-skill-title]")!;
    const box = root.querySelector<HTMLElement>("[data-scenebox]")!;
    const inner = root.querySelector<HTMLElement>("[data-sceneinner]")!;
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    let cur = 0;
    let timer = 0;
    let hovering = false;

    const fit = () => {
      const s = box.clientWidth / 640;
      inner.style.transform = `scale(${s})`;
      box.style.height = `${360 * s}px`;
    };
    new ResizeObserver(fit).observe(box);
    fit();

    const show = (i: number) => {
      cur = i;
      tabs.forEach((t, k) => {
        t.setAttribute("aria-selected", String(k === i));
        const fill = t.querySelector<HTMLElement>(".sk-fill")!;
        fill.classList.remove("sk-run");
        if (k === i && !reduce) {
          void fill.offsetWidth;
          fill.classList.add("sk-run");
        }
      });
      panels.forEach((p, k) => {
        p.hidden = k !== i;
        if (k === i) p.querySelectorAll<HTMLElement>(".sk-chip").forEach((c) => { c.style.animation = "none"; void c.offsetWidth; c.style.animation = ""; });
      });
      scenes.forEach((sc, k) => { sc.hidden = k !== i; }); // re-showing restarts that scene's loop
      title.textContent = tabs[i].querySelector("span span")!.textContent;
      schedule();
    };
    const schedule = () => {
      clearTimeout(timer);
      if (reduce) return;
      timer = window.setTimeout(() => { if (!hovering) show((cur + 1) % tabs.length); else schedule(); }, 9000);
    };
    tabs.forEach((t, i) => t.addEventListener("click", () => show(i)));
    root.addEventListener("pointerenter", () => { hovering = true; });
    root.addEventListener("pointerleave", () => { hovering = false; });
    show(0);
  }
</script>
