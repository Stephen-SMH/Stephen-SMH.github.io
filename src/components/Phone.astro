---
const { class: className = "", style = "" } = Astro.props as { class?: string; style?: string };
---
<div class:list={["overflow-hidden rounded-[1.7rem] border-[5px] border-ink/80 bg-core p-2 shadow-[0_24px_50px_-18px_rgba(0,0,0,0.55)]", className]} style={style}>
  <span class="mx-auto mb-2 block h-1.5 w-9 rounded-full bg-ink/80"></span>
  <slot />
</div>
