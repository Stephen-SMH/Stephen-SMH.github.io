---
import type { Dict } from "@/content";
import Bezel from "./Bezel.astro";
import MonoLabel from "./MonoLabel.astro";
import Reveal from "./Reveal.astro";
import Section from "./Section.astro";
import SectionHead from "./SectionHead.astro";
import { bentoTone } from "./ui";

const { about } = Astro.props as { about: Dict["about"] };
const spans = ["md:col-span-4", "md:col-span-2", "md:col-span-2", "md:col-span-4"];
---
<Section id="about">
  <SectionHead eyebrow={about.eyebrow} title={about.title} />

  <div class="grid gap-12 lg:grid-cols-[1.15fr_0.85fr] lg:gap-16">
    <div>
      <div class="space-y-6">
        {about.paragraphs.map((p) => (
          <p data-words class="max-w-[60ch] text-lg leading-[1.75] text-ink sm:text-xl sm:leading-[1.7]">{p}</p>
        ))}
      </div>

      <div class="mt-16 grid gap-4 md:grid-cols-6">
        {about.principles.map((pr, i) => (
          <Reveal variant="card" class={spans[i % spans.length]}>
            <Bezel lift tilt class="h-full" core={`p-6 ${bentoTone(i)}`}>
              <h3 class="font-display text-lg font-semibold tracking-tight text-ink">{pr.title}</h3>
              <p class="mt-3 text-[14px] leading-relaxed text-ink-soft">{pr.body}</p>
            </Bezel>
          </Reveal>
        ))}
      </div>
    </div>

    <Reveal>
      <Bezel class="lg:sticky lg:top-24" core="p-7 sm:p-9">
        <img
          src="/portrait.jpg"
          alt="Portrait of Soe Moe Htet"
          width="800"
          height="1000"
          loading="lazy"
          decoding="async"
          class="mb-8 aspect-[4/5] w-full rounded-2xl object-cover object-[50%_30%] ring-1 ring-inset ring-rule"
        />
        <MonoLabel>{about.collabTitle}</MonoLabel>
        <dl class="mt-5 space-y-5">
          {about.collab.map((c) => (
            <div>
              <dt class="text-[13px] font-medium text-accent">{c.label}</dt>
              <dd class="mt-1.5 text-[14px] leading-relaxed text-ink-soft">{c.value}</dd>
            </div>
          ))}
        </dl>

        <div class="my-8 h-px bg-rule"></div>
        <MonoLabel>{about.educationTitle}</MonoLabel>
        <ul class="mt-4 space-y-4">
          {about.education.map((e) => (
            <li>
              <p class="text-[15px] text-ink">{e.school}</p>
              <p class="text-[14px] text-ink-soft">{e.degree}</p>
              <p class="mt-1 font-mono text-[12px] text-ink-faint">{e.period}</p>
            </li>
          ))}
        </ul>

        <div class="my-8 h-px bg-rule"></div>
        <MonoLabel>{about.languagesTitle}</MonoLabel>
        <ul class="mt-4 space-y-2">
          {about.languages.map((l) => (
            <li class="text-[14px] text-ink-soft"><span class="text-ink">{l.name}</span> - {l.level}</li>
          ))}
        </ul>

        <div class="my-8 h-px bg-rule"></div>
        <MonoLabel>{about.awardsTitle}</MonoLabel>
        <ul class="mt-4 space-y-2">
          {about.awards.map((a) => <li class="text-[14px] text-ink-soft">{a}</li>)}
        </ul>

        <div class="my-8 h-px bg-rule"></div>
        <MonoLabel>{about.activitiesTitle}</MonoLabel>
        <ul class="mt-4 space-y-3">
          {about.activities.map((a) => (
            <li class="text-[14px] leading-relaxed text-ink-soft"><span class="text-ink">{a.title}</span> - {a.body}</li>
          ))}
        </ul>
      </Bezel>
    </Reveal>
  </div>
</Section>
