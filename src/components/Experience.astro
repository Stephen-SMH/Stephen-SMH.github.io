---
import type { Dict } from "@/content";
import Reveal from "./Reveal.astro";
import Section from "./Section.astro";
import SectionHead from "./SectionHead.astro";
import TagList from "./TagList.astro";

const { experience } = Astro.props as { experience: Dict["experience"] };
---
<Section id="experience">
  <SectionHead title={experience.title} />

  <ol>
    {experience.items.map((job, i) => (
      <li>
        {i > 0 && <div class="draw-rule" data-rule></div>}
        <div class="grid gap-6 py-12 md:grid-cols-[0.34fr_0.66fr] md:gap-12">
          <Reveal class="md:sticky md:top-28 md:self-start">
            <p class="font-mono text-[13px] text-accent">{job.period}</p>
            <h3 class="mt-3 font-display text-2xl font-semibold leading-tight tracking-tight text-ink">{job.org}</h3>
            {(job.place || job.kind) && (
              <p class="mt-2 text-[13.5px] leading-snug text-ink-soft">
                {[job.place, job.kind].filter(Boolean).join(", ")}
              </p>
            )}
          </Reveal>

          <Reveal>
            <h4 class="font-display text-xl font-semibold tracking-tight text-ink sm:text-2xl">{job.role}</h4>
            <p class="mt-4 max-w-[62ch] text-[16px] leading-[1.75] text-ink">{job.summary}</p>
            <ul class="mt-6 space-y-3.5" data-stagger-list>
              {job.bullets.map((b) => (
                <li class="flex gap-4 text-[14.5px] leading-[1.75] text-ink-soft">
                  <span aria-hidden="true" data-bullet-dash class="mt-[0.8em] h-px w-4 shrink-0 origin-left bg-accent"></span>
                  <span>{b}</span>
                </li>
              ))}
            </ul>
            <TagList tags={job.tags} />
          </Reveal>
        </div>
      </li>
    ))}
  </ol>
</Section>
